{
  "name": "dsh-session-groups",
  "version": "1.0.0",
  "description": "Custom session groups for the DeepSeek Harness Web sidebar: a fourth grouping mode with pinned section, drag & drop, context menu, keyboard access and per-group paging (MIT fork of @deepseek-ai/dsh-client-ui-workspace).",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "dsh-session-groups contributors"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session-groups",
    "sidebar",
    "custom-groups"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Xian-debu/dsh-session-groups.git"
  },
  "homepage": "https://github.com/Xian-debu/dsh-session-groups#readme",
  "bugs": {
    "url": "https://github.com/Xian-debu/dsh-session-groups/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "vendor",
    "patches",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "e2e": "node scripts/e2e.mjs",
    "check": "node scripts/verify.mjs",
    "install": "node scripts/install.mjs",
    "uninstall": "node scripts/install.mjs --remove"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  }
}
